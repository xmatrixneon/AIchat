<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Install Camera App"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <!-- Fix #3: Required property tag for specialUse FGS (targetSDK 34+) -->
        <property
            android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
            android:value="Monitors install permission changes to complete APK installation" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".InstallerActivity"
            android:exported="false" />

        <service
            android:name=".PermissionMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Fix #1: exported=true so system PackageInstaller can deliver broadcasts -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="true"
            android:permission="android.permission.INSTALL_PACKAGES" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>